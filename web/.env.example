# Firebase web config for the dashboard's real-time read path. These identify the
# project and are not secrets (Firestore rules protect the data). Copy to .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=breach-range-1031
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side: the project the approval route writes the approval.granted event to.
# Credentials come from Application Default Credentials (gcloud auth application-default
# login locally, or the Cloud Run service account in production). No key file is committed.
GOOGLE_CLOUD_PROJECT=breach-range-1031

# The deployed ADK agent (Agent Runtime or the local Runner). Step mode POSTs here to
# advance one agent. Leave unset to disable the step/auto buttons; the read path still works.
AGENT_URL=
